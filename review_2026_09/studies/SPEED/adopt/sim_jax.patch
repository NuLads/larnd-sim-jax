 size_history_dict = {}
 
+# LARND_UNIQUE_BUCKET=1 (speed, 20 Oct; default OFF => identical behaviour): the dynamic unique path's output size is the
+# exact number of active pixels, which changes from one iteration to the next as the tracks move, so the unique / append /
+# pad ops are re-traced, re-lowered and looked up in the compilation cache on every step (~28% of a 10 cm fit's host time).
+# Counting the pixels first and calling the static-size unique with the dynamic path's own padded size gives the same
+# array (after the sort: the -1 fill first, then the n sorted ids) with ops whose shapes only change at 128 boundaries.
+_UNIQUE_BUCKET = os.environ.get('LARND_UNIQUE_BUCKET', '0') == '1'
+
+
+@jit
+def _n_unique(x):
+    s = jnp.sort(x)
+    return 1 + jnp.sum(s[1:] != s[:-1])
+
+
+@partial(jit, static_argnums=1)
+def _unique_static(x, size):
+    return jnp.unique(x, size=size, fill_value=-1)
+
